# BuildKit must never open leadgen/data (uid 10001, holds the Telegram session): the update
# runs as leadfinder-deploy. It skips excluded directories only while every "!" exception is
# a plain path, optionally ending in /** (one "!leadgen/*.py" or "!x/*.sql" turns that off),
# so modules are listed by name. tests/test_deploy.py keeps this list in sync.
*
!Dockerfile
!requirements.txt
!leadgen/__init__.py
!leadgen/accounts.py
!leadgen/adapters.py
!leadgen/ai_admin.py
!leadgen/ai_offers.py
!leadgen/ai_prompts.py
!leadgen/ai_scoring.py
!leadgen/app.py
!leadgen/billing.py
!leadgen/bot.py
!leadgen/core.py
!leadgen/crm.py
!leadgen/database.py
!leadgen/db_store.py
!leadgen/demand.py
!leadgen/drafts.py
!leadgen/feedback.py
!leadgen/filtered_cleanup.py
!leadgen/heartbeat.py
!leadgen/integrations.py
!leadgen/lead_actions.py
!leadgen/observability.py
!leadgen/payments.py
!leadgen/plan_requests.py
!leadgen/product.py
!leadgen/projects.py
!leadgen/rate_limit.py
!leadgen/reminders.py
!leadgen/source_registry.py
!leadgen/team_notifications.py
!leadgen/teams.py
!leadgen/telegram_accounts.py
!leadgen/telegram_monitor.py
!leadgen/telegram_replies.py
!leadgen/tg_auth.py
!leadgen/web.py
!leadgen/web_auth.py
!leadgen/web_migrate.py
!leadgen/web_projects.py
!leadgen/web_replies.py
!leadgen/web_telegram.py
!leadgen/web_tg.py
!leadgen/yookassa.py
!leadgen/sources.json
!leadgen/web_templates/**
!leadgen/web_static/**
!supabase/migrations/**
leadgen/data
