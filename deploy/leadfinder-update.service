[Unit]
Description=Update and restart IT Lead Finder from GitHub
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# Not root: a dedicated account in the docker group (created by deploy/install-auto-update.sh).
User=leadfinder-deploy
Group=leadfinder-deploy
SupplementaryGroups=docker
WorkingDirectory=/opt/leadfinder
ExecStart=/opt/leadfinder/deploy/leadfinder-update.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# git pull and the deployed-commit marker write the checkout; the docker CLI keeps its state in HOME.
ReadWritePaths=/opt/leadfinder /var/lib/leadfinder-deploy
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
