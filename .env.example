TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_CHAT_IDS=
# Свой Postgres на сервере (сервис db в compose.yaml; пароль — LEADGEN_DB_PASSWORD из .env.db, см. .env.db.example и DEPLOY.md §16):
DATABASE_URL=postgresql://leadgen:LEADGEN_DB_PASSWORD@db:5432/leadgen
# Supabase (прежний вариант и откат): Session pooler, порт 5432.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Пул соединений веб-кабинета (на каждый процесс gunicorn). MAX ≈ числу потоков воркера, MIN ≤ MAX.
DB_POOL_MAX=2
DB_POOL_MIN=1
# Сколько секунд запрос ждёт свободное соединение, потом ошибка.
DB_POOL_TIMEOUT=10
# none — отключить prepared statements (нужно только для transaction pooler Supabase, порт 6543). Пусто — по умолчанию psycopg.
DB_PREPARE_THRESHOLD=
# Для чтения публичных чатов от имени вашего Telegram-аккаунта:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Ключ шифрования личных Telegram-сессий. Создайте командой:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_SESSION_ENCRYPTION_KEY=
# Веб-кабинет. WEB_SECRET_KEY должен содержать минимум 32 случайных символа.
WEB_SECRET_KEY=
TELEGRAM_BOT_USERNAME=
# Имена хостов через запятую, без протокола и пути.
WEB_ALLOWED_HOSTS=localhost,127.0.0.1
# Telegram ID администраторов кабинета через запятую, например 123,456.
WEB_ADMIN_TELEGRAM_IDS=
# Служебные/рабочие аккаунты (Telegram ID через запятую): всегда тариф «Команда» без срока, как у администраторов.
UNLIMITED_TELEGRAM_IDS=
# Публичный адрес сайта без слеша в конце. Используется в кнопках бота и ссылках Mini App.
WEB_PUBLIC_URL=https://signalid.ru
# 1 — бот присылает кнопки Telegram Mini App вместо ссылок на сайт. Включайте после настройки Mini App в BotFather.
MINIAPP_ENABLED=0
# AI-офферы. Ключ хранится только в .env сервера и не добавляется в Git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Лимиты AI-откликов, проектов и участников задаются тарифами в leadgen/billing.py.
# Публичный API и webhook временно скрыты; 1 — снова включить маршруты, очередь и доставку.
INTEGRATIONS_ENABLED=0
# Цена участника беты для «Старт» назначается новым регистрациям; 0 — закончить бету.
BETA_FOUNDER_OPEN=1
# Дата конца беты (ISO, полночь МСК): ранний доступ пользуется «Старт» бесплатно до неё, затем — бесплатный тариф.
BETA_ENDS_AT=2026-11-15
# AI-оценка лидов (один раз на лид, общая для всех пользователей). Работает в процессе бота при заданном GROQ_API_KEY.
# 0 — выключить. Быстрая дешёвая модель со строгим JSON-выводом.
AI_SCORING_ENABLED=1
GROQ_SCORING_MODEL=openai/gpt-oss-20b
# Лидов в одном запросе (1–10), таймаут запроса в секундах, сколько секунд свежий лид ждёт оценки перед отправкой.
AI_SCORING_BATCH=5
AI_SCORING_TIMEOUT=20
AI_SCORING_WAIT_SECONDS=25
# Оцениваются только лиды не старше стольких часов (ограничивает разовый бэклог при первом запуске).
AI_SCORING_MAX_AGE_HOURS=48
# Максимум оценённых лидов за 24 часа (защита от перерасхода) и примеры из оценок пользователей в промпте (0 — выкл.).
AI_SCORING_DAILY_LIMIT=2000
AI_SCORING_FEWSHOT=1
# Отклики с личного Telegram-аккаунта: максимум за сутки на человека и одному получателю (1–3).
REPLY_DAILY_LIMIT=30
REPLY_RECIPIENT_DAILY_LIMIT=2
# Поддержка: username в Telegram без @. Ссылка «Написать в поддержку»; кнопки тарифов отправляют заявку в бот владельцу.
SUPPORT_TELEGRAM=
# Чат для уведомлений об обратной связи, опросах беты и заявках на тарифы (ID через запятую). Пусто — личные чаты WEB_ADMIN_TELEGRAM_IDS.
FEEDBACK_CHAT_ID=
# Реквизиты продавца для подвала, оферты и политики, например: ИП Иванов И. И., ИНН 000000000000
LEGAL_ENTITY=
# ЮKassa: оплата тарифов (умный платёж с переходом на страницу ЮKassa), «Чеки от ЮKassa» и автопродление.
# shopId из личного кабинета ЮKassa. У тестового магазина свой shopId.
YOOKASSA_SHOP_ID=
# Секретный ключ: test_… для тестового магазина, live_… для боевого. Пусто — оплата выключена, работает ручная заявка на тариф.
YOOKASSA_SECRET_KEY=
# Код ставки НДС в чеке: 1 — без НДС (УСН).
YOOKASSA_VAT_CODE=1
# Код системы налогообложения в чеке (1–6). Необязательно: пусто — берётся из настроек магазина.
YOOKASSA_TAX_SYSTEM_CODE=
# 1 — брать IP клиента из X-Real-IP (сайт за nginx); нужно для проверки, что webhook пришёл с адресов ЮKassa.
YOOKASSA_TRUST_PROXY=1
# Номер счётчика Яндекс Метрики. Работает только на публичных страницах, не в кабинете.
YANDEX_METRIKA_ID=
# Коды подтверждения прав на сайт из Яндекс.Вебмастер и Google Search Console (мета-теги в <head>).
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=
# Для необязательного адаптера hh:
HH_USER_AGENT=
# Алерты об ошибках в Telegram (основной канал): chat id рабочего аккаунта владельца, через запятую.
# Пусто — выключено (на другие ID админов не отправляется). Аккаунт должен сначала написать боту /start;
# свой ID можно узнать у @userinfobot. Отправляет тот же бот (TELEGRAM_BOT_TOKEN).
# Одна ошибка — не чаще раза в 10 минут, не больше 20 алертов в час на процесс.
ERROR_ALERT_CHAT_ID=
# 1 — сообщение «✅ <сервис> запущен» при старте (на сайте — от каждого gunicorn-воркера).
ALERT_ON_START=0
# Мониторинг ошибок (необязательно): Sentry или self-hosted GlitchTip (тот же формат DSN). Пусто — выключено.
# Тела запросов, cookies, телефоны, email и токены вычищаются до отправки.
# Проверка после настройки: python -m leadgen.observability --test
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Доля запросов с трассировкой производительности (0–1); 0 — только ошибки.
SENTRY_TRACES_SAMPLE_RATE=0
# Версия в отчётах, например короткий SHA коммита. Пусто — SHA из git, если он доступен.
SENTRY_RELEASE=
