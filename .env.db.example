# Только для контейнера db (compose.yaml, env_file: .env.db). Приложение этот файл не видит.
# Пароли без спецсимволов URL, например: openssl rand -hex 32
# Суперпользователь postgres: администрирование и резервные копии (внутри контейнера через сокет).
POSTGRES_PASSWORD=
# Роль приложения: владелец базы leadgen, не суперпользователь. Тот же пароль указывается в DATABASE_URL в .env:
# DATABASE_URL=postgresql://leadgen:<LEADGEN_DB_PASSWORD>@db:5432/leadgen
LEADGEN_DB_USER=leadgen
LEADGEN_DB_PASSWORD=
